{
  "name": "forge-editor-assistant",
  "displayName": "Forge Editor Assistant",
  "description": "Ask a local llama-server about the selected code.",
  "version": "0.1.0",
  "publisher": "v1-byte",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Machine Learning"],
  "activationEvents": ["onCommand:forge.askSelection"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [{ "command": "forge.askSelection", "title": "Forge: Ask About Selection" }],
    "configuration": { "title": "Forge Editor", "properties": {
      "forge.endpoint": { "type": "string", "default": "http://127.0.0.1:8080/v1", "description": "OpenAI-compatible llama-server endpoint" },
      "forge.model": { "type": "string", "default": "", "description": "Model ID served by llama-server; empty uses server default" }
    }}
  },
  "scripts": { "compile": "tsc -p .", "typecheck": "tsc -p . --noEmit" },
  "devDependencies": { "@types/node": "^22.15.0", "@types/vscode": "^1.100.0", "typescript": "^5.8.3" }
}
