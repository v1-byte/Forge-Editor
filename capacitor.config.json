{
  "appId": "com.codeforge.editor",
  "appName": "CodeForge",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#070d12",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "Filesystem": {
      "android": {
        "requestPermissions": true
      }
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#070d12"
    }
  }
}
